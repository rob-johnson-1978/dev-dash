@page
@using DevDash
@using DevDash.Areas.DevDash.Pages
@using DevDash.Features.Dashboard
@inject Configuration DevDashConfiguration
@model DashboardModel


@section Styles {
    <link rel="stylesheet" href="_content/DevDash/devdash-dashboard.css" asp-append-version="true" />
}

<div class="runnable-processes">
    @foreach (var proc in Model.RunnableProcesses)
    {
        <div class="runnable-process" data-process-id="@proc.Id">
            <div class="runnable-process-header">
                <h2>@proc.Id</h2>
                <div class="runnable-process-header-buttons">
                    <span class="button start disabled material-symbols-outlined"
                          onclick="disableRunnableProcessButtons('@proc.Id'); sendDashboardProcessCommand('@proc.Id', 'start-process');"
                          title="Start process">play_circle</span>
                    <span class="button stop disabled material-symbols-outlined"
                          onclick="disableRunnableProcessButtons('@proc.Id'); sendDashboardProcessCommand('@proc.Id', 'stop-process');"
                          title="Stop process">stop_circle</span>
                    <span class="button restart disabled material-symbols-outlined"
                          onclick="disableRunnableProcessButtons('@proc.Id'); sendDashboardProcessCommand('@proc.Id', 'restart-process');"
                          title="Restart process">settings_backup_restore</span>
                    <span class="button clear-logs material-symbols-outlined"
                          onclick="clearLogs('@proc.Id')"
                          title="Clear process logs">clear_all</span>
                    <span class="button material-symbols-outlined"
                          onclick="copyOutput('@proc.Id')"
                          title="Copy log output">content_copy</span>
                    <span class="button full-screen material-symbols-outlined"
                          onclick="expandOrCollapseRunnableProcess('@proc.Id')"
                          title="Expand">fullscreen</span>
                    <span class="button exit-full-screen material-symbols-outlined"
                          onclick="expandOrCollapseRunnableProcess('@proc.Id')"
                          title="Collapse">fullscreen_exit</span>
                </div>
            </div>
            <div class="runnable-process-console-output"><pre><code></code></pre></div>
        </div>
    }
</div>
<div id="dashboard_global_actions">
    <span id="global_start"
          class="button disabled material-symbols-outlined"
          onclick="disableGlobalButtons(); sendDashboardCommand('start-dashboard');"
          title="Start Dashboard">play_circle</span>
    <span id="global_stop"
          class="button disabled material-symbols-outlined"
          onclick="disableGlobalButtons(); sendDashboardCommand('stop-dashboard');"
          title="Stop Dashboard">stop_circle</span>
    <span id="global_restart"
          class="button disabled material-symbols-outlined"
          onclick="disableGlobalButtons(); sendDashboardCommand('restart-dashboard');"
          title="Restart Dashboard">settings_backup_restore</span>
    <span id="global_clear_logs"
          class="button material-symbols-outlined"
          onclick="clearLogs()"
          title="Clear Dashboard Logs">clear_all</span>
</div>

@section Scripts {
    <script type="text/javascript">
        // events
        window.EVENT_NAMES_DASHBOARD_STATUS_PUBLISHED = '@nameof(DashboardStatusPublished)';
        window.EVENT_NAMES_RUNNABLE_PROCESSES_STARTING = '@nameof(RunnableProcessesStarting)';
        window.EVENT_NAMES_RUNNABLE_PROCESS_STATUS_PUBLISHED = '@nameof(RunnableProcessStatusPublished)';
        window.EVENT_NAMES_MESSAGE_AREA_MESSAGE_PUBLISHED = '@nameof(MessageAreaMessagePublished)';
        window.EVENT_NAMES_PROCESS_OUTPUT_LINE_EMITTED = '@nameof(ProcessOutputLineEmitted)';
        window.EVENT_NAMES_PROCESS_ERROR_OUTPUT_LINE_EMITTED = '@nameof(ProcessErrorOutputLineEmitted)';
        
        // dashboard behaviours
        window.ENUMS_DASHBOARD_BEHAVIOUR_NONE = '@DashboardBehaviour.None';
        window.ENUMS_DASHBOARD_BEHAVIOUR_CONFIGURED = '@DashboardBehaviour.Configured';
        window.ENUMS_DASHBOARD_BEHAVIOUR_STARTING = '@DashboardBehaviour.Starting';
        window.ENUMS_DASHBOARD_BEHAVIOUR_STARTED = '@DashboardBehaviour.Started';

        // process behaviours
        window.ENUMS_PROCESS_BEHAVIOUR_NONE = '@RunnableProcessBehaviour.None';
        window.ENUMS_PROCESS_BEHAVIOUR_START_REQUESTED = '@RunnableProcessBehaviour.StartRequested';
        window.ENUMS_PROCESS_BEHAVIOUR_STARTED = '@RunnableProcessBehaviour.Started';
        window.ENUMS_PROCESS_BEHAVIOUR_STOPPED = '@RunnableProcessBehaviour.Stopped';

        // flags
        window.CONFIG_CONSOLE_OUTPUT_MAX_LINES = '@DevDashConfiguration.ConsoleOutputMaxLines';
        window.CONFIG_CONSOLE_OUTPUT_LINE_REMOVAL_BATCH_SIZE = '@DevDashConfiguration.ConsoleOutputLineRemovalBatchSize';
    </script>
    <script type="text/javascript" src="_content/DevDash/devdash-dashboard.js" asp-append-version="true"></script>
}
