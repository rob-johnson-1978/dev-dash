@using DevDash.Features.Dashboard

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DevDash - Your OPEN SOURCE development dashboard</title>
    <link rel="stylesheet" href="_content/DevDash/devdash.css" asp-append-version="true" />    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <h1><a href="/" title="Home">devdash</a></h1>
        <subtitle>Your OPEN SOURCE development dashboard</subtitle>
    </header>
    <main>
        <section id="content">
            @RenderBody()
        </section>
    </main>
    <div id="message_container"></div>
    <div id="modal_background"></div>
    <script type="text/javascript" src="_content/DevDash/devdash.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)    
</body>
</html>
