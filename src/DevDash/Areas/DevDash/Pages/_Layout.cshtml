@using DevDash.Features.Dashboard

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>DevDash - local dev, made easy</title>
    <link rel="apple-touch-icon" sizes="180x180" href="_content/DevDash/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/DevDash/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="_content/DevDash/favicon/favicon-16x16.png" />
    <link rel="manifest" href="_content/DevDash/favicon/site.webmanifest" />
    <link rel="stylesheet" href="_content/DevDash/devdash.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <h1><a href="/" title="Home">devdash</a></h1>
        <subtitle>local.dev.made.easy.</subtitle>
    </header>
    <main>
        <section id="content">
            @RenderBody()
        </section>
    </main>
    <div id="message_container"></div>
    <div id="modal_background"></div>
    <script type="text/javascript" src="_content/DevDash/devdash.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)    
</body>
</html>
